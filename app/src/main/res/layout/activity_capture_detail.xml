<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_m">

        <TextView
            android:id="@+id/captureSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_m"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_s"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/SectionHeader"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="0dp"
                android:text="@string/section_screenshot" />

            <Button
                android:id="@+id/editToggleButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_edit_elements" />

            <Button
                android:id="@+id/saveEditsButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/overlay_save"
                android:visibility="gone" />

            <Button
                android:id="@+id/cancelEditsButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/overlay_discard"
                android:visibility="gone" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_s"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="1dp">

            <com.elementinspector.app.ui.common.BoundedHeightScrollSection
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:id="@+id/screenshotContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.elementinspector.app.ui.common.BoundedHeightScrollSection>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/editHintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_s"
            android:text="@string/overlay_hint"
            android:textColor="@color/on_surface_variant"
            android:textSize="13sp"
            android:visibility="gone" />

        <androidx.cardview.widget.CardView
            android:id="@+id/attributePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_l"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="1dp">

            <com.elementinspector.app.ui.common.BoundedHeightScrollSection
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:heightFraction="0.25">

                <LinearLayout
                    android:id="@+id/attributeListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_m" />
            </com.elementinspector.app.ui.common.BoundedHeightScrollSection>
        </androidx.cardview.widget.CardView>

        <TextView style="@style/SectionHeader" android:text="@string/section_selected_elements" />
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_l"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="1dp">

            <com.elementinspector.app.ui.common.BoundedHeightScrollSection
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/selectedElementsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_m" />
            </com.elementinspector.app.ui.common.BoundedHeightScrollSection>
        </androidx.cardview.widget.CardView>

        <TextView style="@style/SectionHeader" android:text="@string/section_tree" />
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="1dp">

            <com.elementinspector.app.ui.common.BoundedHeightScrollSection
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/treeRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:padding="@dimen/spacing_s" />
            </com.elementinspector.app.ui.common.BoundedHeightScrollSection>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
